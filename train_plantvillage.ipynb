    "def plot_history(history, prefix, outputs_dir):\n",
    "    hist = history.history\n",
    "\n",
    "    if \"accuracy\" in hist and \"val_accuracy\" in hist:\n",
    "        plt.figure(figsize=(8, 5))\n",
    "        plt.plot(hist[\"accuracy\"], label=\"train_accuracy\")\n",
    "        plt.plot(hist[\"val_accuracy\"], label=\"val_accuracy\")\n",
    "        plt.title(f\"Accuracy - {prefix}\")\n",
    "        plt.xlabel(\"Epoch\")\n",
    "        plt.ylabel(\"Accuracy\")\n",
    "        plt.legend()\n",
    "        plt.tight_layout()\n",
    "        plt.savefig(outputs_dir / f\"{prefix}_accuracy.png\", dpi=150)\n",
    "        plt.show()\n",
    "\n",
    "    if \"loss\" in hist and \"val_loss\" in hist:\n",
    "        plt.figure(figsize=(8, 5))\n",
    "        plt.plot(hist[\"loss\"], label=\"train_loss\")\n",
    "        plt.plot(hist[\"val_loss\"], label=\"val_loss\")\n",
    "        plt.title(f\"Loss - {prefix}\")\n",
    "        plt.xlabel(\"Epoch\")\n",
    "        plt.ylabel(\"Loss\")\n",
    "        plt.legend()\n",
    "        plt.tight_layout()\n",
    "        plt.savefig(outputs_dir / f\"{prefix}_loss.png\", dpi=150)\n",
    "        plt.show()\n",
    "\n",
    "plot_history(h1, \"warmup\", OUTPUTS_DIR)\n",
    "plot_history(h2, \"finetune\", OUTPUTS_DIR)"
   ]
  },
