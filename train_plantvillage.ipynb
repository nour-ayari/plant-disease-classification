    "base.trainable = True\n",
    "\n",
    "# On fige toutes les couches sauf les 50 dernières\n",
    "for layer in base.layers[:-50]:\n",
    "    layer.trainable = False\n",
    "\n",
    "finetune_history_path = REPORTS_DIR / \"finetune_history.csv\"\n",
    "\n",
    "model.compile(\n",
    "    optimizer=tf.keras.optimizers.Adam(1e-5),\n",
    "    loss=\"categorical_crossentropy\",\n",
    "    metrics=[\"accuracy\"]\n",
    ")\n",
    "\n",
    "finetune_callbacks = [\n",
    "    EarlyStopping(monitor=\"val_accuracy\", patience=7, restore_best_weights=True),\n",
    "    ReduceLROnPlateau(monitor=\"val_loss\", factor=0.2, patience=3, min_lr=1e-7),\n",
    "    ModelCheckpoint(str(MODELS_DIR / \"finetune_best.keras\"), monitor=\"val_accuracy\", save_best_only=True),\n",
    "    CSVLogger(str(finetune_history_path))\n",
    "]\n",
    "\n",
    "h2 = model.fit(\n",
    "    train_gen,\n",
    "    epochs=30,\n",
    "    validation_data=val_gen,\n",
    "    class_weight=class_weights,\n",
    "    callbacks=finetune_callbacks\n",
    ")\n",
    "\n",
    "final_model_path = MODELS_DIR / \"plantvillage_final.keras\"\n",
    "model.save(final_model_path)\n",
    "\n",
    "print(\"Modèle final sauvegardé :\", final_model_path)"
   ]
