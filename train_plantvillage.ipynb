    "def summarize_split(split_root: Path):\n",
    "    rows = []\n",
    "    for class_dir in sorted([d for d in split_root.iterdir() if d.is_dir()]):\n",
    "        n = len([p for p in class_dir.iterdir() if p.is_file()])\n",
    "        rows.append({\"class_name\": class_dir.name, \"count\": n})\n",
    "    return pd.DataFrame(rows).sort_values(\"class_name\").reset_index(drop=True)\n",
    "\n",
    "train_df = summarize_split(TRAIN_DIR)\n",
    "val_df = summarize_split(VAL_DIR)\n",
    "test_df = summarize_split(TEST_DIR)\n",
    "\n",
    "display(train_df.head())\n",
    "print(\"Nb classes train:\", len(train_df))\n",
    "print(\"Total train:\", train_df[\"count\"].sum())\n",
    "print(\"Total val:\", val_df[\"count\"].sum())\n",
    "print(\"Total test:\", test_df[\"count\"].sum())"
   ]
