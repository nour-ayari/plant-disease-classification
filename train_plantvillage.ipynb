    "warmup_hist_df = pd.DataFrame(h1.history)\n",
    "warmup_hist_df[\"phase\"] = \"warmup\"\n",
    "warmup_hist_df[\"epoch_in_phase\"] = np.arange(1, len(warmup_hist_df) + 1)\n",
    "\n",
    "finetune_hist_df = pd.DataFrame(h2.history)\n",
    "finetune_hist_df[\"phase\"] = \"finetune\"\n",
    "finetune_hist_df[\"epoch_in_phase\"] = np.arange(1, len(finetune_hist_df) + 1)\n",
    "\n",
    "history_df = pd.concat([warmup_hist_df, finetune_hist_df], ignore_index=True)\n",
    "history_df.to_csv(REPORTS_DIR / \"full_training_history.csv\", index=False)\n",
    "\n",
    "display(history_df.tail())\n",
    "\n",
    "best_warmup = warmup_hist_df[\"val_accuracy\"].max() if \"val_accuracy\" in warmup_hist_df else None\n",
    "best_finetune = finetune_hist_df[\"val_accuracy\"].max() if \"val_accuracy\" in finetune_hist_df else None\n",
    "\n",
    "print(\"Best warmup val_accuracy:\", best_warmup)\n",
    "print(\"Best finetune val_accuracy:\", best_finetune)"
